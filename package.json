{
  "name": "eslint-config-e7npm",
  "version": "0.1.77",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreigec/eslint-config-e7npm.git"
  },
  "bin": {
    "e7-cloc": "./bin/e7-cloc.cjs",
    "e7-jscpd": "./bin/e7-jscpd.cjs",
    "e7-knip": "./bin/e7-knip.cjs",
    "e7-min": "./bin/e7-min.cjs",
    "e7-oxfmt": "./bin/e7-oxfmt.cjs",
    "e7-oxlint": "./bin/e7-oxlint.cjs"
  },
  "files": [
    "README.md",
    "bin",
    "eslint.config.js",
    "oxfmt.json",
    "oxlint.json",
    "tsconfig.default.json"
  ],
  "exports": {
    ".": "./eslint.config.js",
    "./eslint.config.js": "./eslint.config.js",
    "./oxfmt": "./oxfmt.json",
    "./oxfmt.json": "./oxfmt.json",
    "./oxlint": "./oxlint.json",
    "./oxlint.json": "./oxlint.json",
    "./tsconfig.default.json": "./tsconfig.default.json"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "cloc": "node ./bin/e7-cloc.cjs",
    "format": "node ./bin/e7-oxfmt.cjs --no-lint . && eslint . --fix && node ./bin/e7-oxlint.cjs --config ./oxlint.self.json --fix .",
    "jscpd": "node ./bin/e7-jscpd.cjs",
    "knip": "node ./bin/e7-knip.cjs",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:oxfmt": "node ./bin/e7-oxfmt.cjs --check .",
    "lint:oxlint": "node ./bin/e7-oxlint.cjs --config ./oxlint.self.json .",
    "lint:test": "node --test",
    "lint": "pnpm run /^lint:/",
    "min": "node ./bin/e7-min.cjs",
    "test": "node --test"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "strip-json-comments": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
