{
  "name": "eslint-config-e7npm",
  "version": "0.1.62",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreigec/eslint-config-e7npm.git"
  },
  "bin": {
    "e7-cloc": "./bin/e7-cloc.cjs",
    "e7-jscpd": "./bin/e7-jscpd.cjs",
    "e7-knip": "./bin/e7-knip.cjs",
    "e7-min": "./bin/e7-min.cjs",
    "e7-oxfmt": "./bin/e7-oxfmt.cjs",
    "e7-oxlint": "./bin/e7-oxlint.cjs"
  },
  "files": [
    "bin",
    "eslint.config.js",
    "oxfmt.json",
    "oxlint.json",
    "tsconfig.default.json"
  ],
  "exports": {
    ".": "./eslint.config.js",
    "./eslint.config.js": "./eslint.config.js",
    "./oxfmt": "./oxfmt.json",
    "./oxfmt.json": "./oxfmt.json",
    "./oxlint": "./oxlint.json",
    "./oxlint.json": "./oxlint.json",
    "./tsconfig.default.json": "./tsconfig.default.json"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "cloc": "node ./bin/e7-cloc.cjs",
    "format": "node ./bin/e7-oxfmt.cjs --no-lint . && eslint . --fix && node ./bin/e7-oxlint.cjs --config ./oxlint.self.json --fix .",
    "jscpd": "node ./bin/e7-jscpd.cjs",
    "knip": "node ./bin/e7-knip.cjs",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:oxfmt": "node ./bin/e7-oxfmt.cjs --check .",
    "lint:oxlint": "node ./bin/e7-oxlint.cjs --config ./oxlint.self.json .",
    "lint": "pnpm run /^lint:/",
    "min": "node ./bin/e7-min.cjs"
  },
  "dependencies": {
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-tailwindcss": "^1.9.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.9.0"
}
